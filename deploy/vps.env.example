# Store the real file OUTSIDE the source tree at /opt/gitsettle/env/production.env.
# chmod 600 that file. Never commit a populated version.
APP_BIND=127.0.0.1
APP_PORT=3000
GITSETTLE_DATA_DIR=/opt/gitsettle/data
# Replace with the exact HTTPS origin served by your reverse proxy.
APP_ORIGIN=https://your-domain.example
TRUST_PROXY_HEADERS=true
SUPPORT_ADMIN_ACCOUNTS=

# Demo mode needs no keys. For testnet, set false and complete all three accounts.
DEMO_MODE=true
NEAR_CONTRACT_ID=
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_VERIFIER_ACCOUNT_ID=
NEAR_VERIFIER_PRIVATE_KEY=
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10
VERIFIER_INTERVAL_MS=15000
VERIFIER_REJECT_INVALID=true
AGENTGUARD_ENABLED=true
AGENTGUARD_MAX_PAYOUT_NEAR=5
AGENTGUARD_DENIED_RECIPIENTS=
AGENTGUARD_KNOWN_RECIPIENTS=
# Optional OpenAI-compatible advisory helper; keep actual keys out of source.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
