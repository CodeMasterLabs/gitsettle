# Store the real file OUTSIDE the source tree at /opt/gitsettle/env/production.env.
# chmod 600 that file. Never commit a populated version.
APP_BIND=0.0.0.0
APP_PORT=80
GITSETTLE_DATA_DIR=/opt/gitsettle/data

# Demo mode needs no keys. For testnet, set false and complete all three accounts.
DEMO_MODE=true
NEAR_CONTRACT_ID=
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_VERIFIER_ACCOUNT_ID=
NEAR_VERIFIER_PRIVATE_KEY=
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10
VERIFIER_INTERVAL_MS=15000
VERIFIER_REJECT_INVALID=true
