# Default: honest local demo, without an account or private keys. `docker compose up --build` works as-is.
# For real testnet escrow: DEMO_MODE=false and set a deployed contract + verifier account.
DEMO_MODE=true
NEAR_CONTRACT_ID=
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_VERIFIER_ACCOUNT_ID=
NEAR_VERIFIER_PRIVATE_KEY=
# Optional read-only token for higher GitHub API limits; never passed to the web container.
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10
VERIFIER_INTERVAL_MS=15000
# Set false if invalid evidence should wait for operator review rather than automatic rejection.
VERIFIER_REJECT_INVALID=true
# AgentGuard's pinned local rules guard automatic release; posters can still review and release.
AGENTGUARD_ENABLED=true
AGENTGUARD_MAX_PAYOUT_NEAR=5
AGENTGUARD_DENIED_RECIPIENTS=
AGENTGUARD_KNOWN_RECIPIENTS=
# Exact browser origin for signed support sessions. Use your HTTPS URL in production.
APP_ORIGIN=http://localhost:3000
# Enable only behind a trusted proxy, with the application port bound to loopback.
TRUST_PROXY_HEADERS=false
SUPPORT_ADMIN_ACCOUNTS=
# Optional bring-your-own OpenAI-compatible AI. Leave blank to use deterministic triage only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Native Node runs only; Docker always uses /data/gitsettle.sqlite.
DATABASE_PATH=./data/gitsettle.sqlite
APP_BIND=0.0.0.0
APP_PORT=3000
# Optional VPS bind mount. Leave unset to use a named Docker volume.
# GITSETTLE_DATA_DIR=/opt/gitsettle/data

# Deployment/seed scripts only. Never add these variables to the web service.
NEAR_POSTER_ACCOUNT_ID=
NEAR_POSTER_PRIVATE_KEY=
NEAR_CONTRIBUTOR_ACCOUNT_ID=
NEAR_CONTRIBUTOR_PRIVATE_KEY=
